# Database Configuration
DATABASE_URL=postgresql://oauth2_user:oauth2_password@postgres:5432/oauth2_auth

# Temporal Configuration
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=oauth2-task-queue
TEMPORAL_IDENTITY_OPS_TASK_QUEUE=flowshield-identity-ops-v1

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-make-it-256-bits-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 Configuration
OAUTH2_CLIENT_ID=oauth2-client
OAUTH2_CLIENT_SECRET=oauth2-client-secret-change-in-production
OAUTH2_CLIENT_CONFIDENTIAL=true
OAUTH2_REDIRECT_URI=http://localhost:3000/callback
OAUTH2_AUTHORIZATION_CODE_EXPIRE_MINUTES=10

# OIDC Configuration (mount private keys from a secret store; never commit them)
OIDC_ISSUER=http://localhost:8000
OIDC_SIGNING_KEY_PATH=/run/secrets/oidc-signing-key.pem
OIDC_ACTIVE_KEY_ID=2026-09
# JSON map of active/previous public key IDs to mounted PEM paths for rotation
OIDC_PUBLIC_KEY_PATHS={"2026-09":"/run/secrets/oidc-signing-public.pem"}
OIDC_ID_TOKEN_EXPIRE_MINUTES=5

# Email Configuration (Gmail example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@oauth2auth.com
EMAIL_FROM_NAME=OAuth2 Auth Service

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security
PASSWORD_MIN_LENGTH=8
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Authentication risk policy (deterministic enforcement is always authoritative)
RISK_POLICY_FAIL_CLOSED=true
# JSON list of IPv4/IPv6 networks that must be denied by the default policy
RISK_POLICY_BLOCKED_CIDRS=[]
# Optional local AI advice is audit-only, non-enforcing, and disabled by default
RISK_POLICY_AI_SHADOW_ENABLED=false
RISK_POLICY_AI_HOST=localhost
RISK_POLICY_AI_PORT=11434
RISK_POLICY_AI_MODEL=llama3
RISK_POLICY_AI_SHADOW_TIMEOUT_SECONDS=1.0

# Observability (leave blank to disable OTLP export outside Compose)
SERVICE_NAME=flowshield-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

# Security simulation lab: disabled by default. The one-command local Compose
# stack enables it with a single internal allowlisted origin.
SECURITY_LAB_ENABLED=false
SECURITY_LAB_BASE_URL=http://localhost:8000
SECURITY_LAB_ALLOWED_BASE_URLS=["http://localhost:8000","http://127.0.0.1:8000"]